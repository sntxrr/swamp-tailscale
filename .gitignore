# BEGIN swamp managed section - DO NOT EDIT

# Runtime data (not needed in version control)
.swamp/

# Local extension sources (developer-specific, not shared)
.swamp-sources.yaml

# Claude Code configuration (managed by swamp)
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
# END swamp managed section

# Local model and vault instances (developer-specific: bound to one operator's
# tailnet name and 1Password-backed OAuth credentials). This repo tracks
# extension *sources*; instances are local state. workflows/ IS tracked —
# those are shareable.
# Leading slash anchors these to the repo root so they do NOT also match
# extensions/models/ (the tracked extension sources).
/models/
/vaults/

# .swamp.yaml carries the datastore block, which names an S3 bucket. The bucket
# is locked down, so the name is an information disclosure rather than an access
# hole -- but it still makes a target easier to find, and this repo is public.
# Only .swamp.yaml.example is tracked.
.swamp.yaml
